#cloud-config
# Rendered by Terraform (templatefile). role = ${role}
#
# OCI gotchas handled here:
#  1. The stock Ubuntu image ships restrictive iptables (REJECT in INPUT and
#     FORWARD) that silently breaks flannel/etcd/apiserver. We insert ACCEPT
#     rules at the top of both chains BEFORE installing k3s, then persist them.
#  2. The VCN security list (separate from the host firewall) is opened in
#     Terraform's network.tf, not here.
#  3. Option A: no load balancer. OCI NATs the node's public IP — it is never
#     present on the interface — so it isn't known at template-render time.
#     We fetch it (and the node's private IP) from the OCI metadata service
#     here in runcmd and build /etc/rancher/k3s/config.yaml at boot, instead
#     of via write_files, so k3s advertises and certs the address operators
#     actually reach the API on.

runcmd:
  - |
    set -e
    # --- open the host firewall before k3s starts ---
    iptables -I INPUT 1 -p tcp --dport 6443 -j ACCEPT
    iptables -I INPUT 1 -p tcp --dport 2379:2380 -j ACCEPT
    iptables -I INPUT 1 -p tcp --dport 10250 -j ACCEPT
    iptables -I INPUT 1 -p udp --dport 8472 -j ACCEPT
    iptables -I INPUT 1 -s 10.0.0.0/16 -j ACCEPT
    iptables -I INPUT 1 -s 10.42.0.0/16 -j ACCEPT
    iptables -I INPUT 1 -s 10.43.0.0/16 -j ACCEPT
    iptables -I FORWARD 1 -s 10.42.0.0/16 -j ACCEPT
    iptables -I FORWARD 1 -d 10.42.0.0/16 -j ACCEPT
    netfilter-persistent save

    # --- discover this node's public + private IPs from the OCI metadata service ---
    PUB=$(curl -s -H "Authorization: Bearer Oracle" http://169.254.169.254/opc/v2/vnics/ | python3 -c "import sys,json;print(json.load(sys.stdin)[0]['publicIp'])")
    PRIV=$(curl -s -H "Authorization: Bearer Oracle" http://169.254.169.254/opc/v2/vnics/ | python3 -c "import sys,json;print(json.load(sys.stdin)[0]['privateIp'])")

    # --- build k3s config.yaml now that PUB/PRIV are known (write_files can't: the IP isn't known at render time) ---
    mkdir -p /etc/rancher/k3s
    {
      echo 'write-kubeconfig-mode: "0644"'
      echo "node-external-ip: $PUB"
      echo "tls-san:"
      echo "  - $PUB"
      echo "  - $PRIV"
%{ if api_dns_name != "" ~}
      echo "  - ${api_dns_name}"
%{ endif ~}
    } > /etc/rancher/k3s/config.yaml
    chmod 0600 /etc/rancher/k3s/config.yaml

    # --- install k3s for this node's role ---
    # Cluster join always targets the private IP of server-0 (intra-VCN,
    # simpler and doesn't depend on the public IP being reachable yet).
    # Only the external advertisement/kubeconfig (above) uses public IPs.
%{ if role == "server-first" ~}
    curl -sfL https://get.k3s.io | sh -s - server --cluster-init --token "${k3s_token}"
%{ endif ~}
%{ if role == "server-join" ~}
    curl -sfL https://get.k3s.io | sh -s - server --server "https://${first_ip}:6443" --token "${k3s_token}"
%{ endif ~}
%{ if role == "agent" ~}
    curl -sfL https://get.k3s.io | K3S_URL="https://${first_ip}:6443" K3S_TOKEN="${k3s_token}" sh -
%{ endif ~}
