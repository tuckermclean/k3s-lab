# OCI k3s bootstrap secrets — copy to secrets.yaml, fill in, then encrypt:
#
#   cp secrets.yaml.example secrets.yaml
#   $EDITOR secrets.yaml
#   cp secrets.yaml secrets.sops.yaml && sops -e -i secrets.sops.yaml && rm secrets.yaml
#   git add secrets.sops.yaml && git commit -m "oci-k3s: add encrypted bootstrap secrets"
#
# Or from the repo root, use top-level make targets:
#   make init-oci && make apply-oci
# (make apply-oci runs make recover-age-key first, so the SOPS key is handled for you.)
#
# NOTE: OCI provider auth (tenancy_ocid, user_ocid, fingerprint,
# api_private_key_path) is NOT read from this file — it's plain Terraform
# variables in terraform.tfvars (see terraform.tfvars.example), the same
# pattern this module already used before this file existed. This file only
# holds values that must never land in tfvars/state: the S3 backend
# credentials and API tokens below.

# AWS credentials — used for the S3 remote state backend (versions.tf). Same
# bucket as ovh-k3s's remote state (k3s-lab-backups), different key
# (terraform/state/oci-k3s).
AWS_ACCESS_KEY_ID: your_aws_access_key_id
AWS_SECRET_ACCESS_KEY: your_aws_secret_access_key

# Cloudflare API token (Zone:Read + DNS:Edit for dcxxiv.com) — for dns.tf's
# oci.dcxxiv.com subdomain A records.
CLOUDFLARE_API_TOKEN: your_cloudflare_api_token

# GitHub PAT (repo scope) — for Flux bootstrap
GITHUB_TOKEN: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
